# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
app-example/

# generated native folders (safe to ignore if using Expo Prebuild)
/ios
/android

# Native build artifacts and signing keys (SECURITY RISK: NEVER COMMIT)
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro bundler cache
.metro-health-check*

# debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# OS generated files
.DS_Store
*.pem

# local env files (Contains secrets like API keys)
.env
.env*.local

# typescript cache
*.tsbuildinfo